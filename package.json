{
  "name": "meindocs",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "dev:ios": "REACT_NATIVE_PACKAGER_HOSTNAME=localhost bun run --cwd apps/mobile dev --ios --localhost",
    "dev:api": "bun run --filter @meindocs/api dev",
    "db:generate": "bun run --cwd packages/database db:generate",
    "db:migrate": "bun run --cwd packages/database db:migrate",
    "db:push": "bun run --cwd packages/database db:push",
    "typecheck": "bun run --filter '@meindocs/*' typecheck",
    "test": "bun test",
    "check:code": "fallow",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "fallow": "^3.27.0",
    "typescript": "~5.9.3"
  }
}
